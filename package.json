{
  "name": "flintpad",
  "productName": "Flintpad",
  "version": "0.1.0",
  "description": "Local-first workspace: Markdown notes, graph, tasks, whiteboards, an API client and a code editor, all as plain files on your machine.",
  "author": "Matheus Chiodi",
  "license": "MIT",
  "homepage": "https://github.com/MatheusChiodi/Flintpad#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatheusChiodi/Flintpad.git"
  },
  "bugs": {
    "url": "https://github.com/MatheusChiodi/Flintpad/issues"
  },
  "keywords": [
    "notes",
    "markdown",
    "local-first",
    "obsidian",
    "wikilinks",
    "knowledge-base",
    "whiteboard",
    "api-client",
    "bruno",
    "electron",
    "desktop-app"
  ],
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node --experimental-strip-types --test \"tests/*.test.mjs\"",
    "test:e2e": "npm run build && node --test tests/e2e/whiteboard.e2e.mjs",
    "dist": "npm run build && electron-builder --win portable",
    "dist:dir": "npm run build && electron-builder --win dir"
  },
  "build": {
    "appId": "com.mchiodi.flintpad",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@typescript/**",
      "node_modules/@lydell/**",
      "node_modules/vscode-langservers-extracted/**"
    ],
    "win": {
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@usebruno/lang": "^0.40.0",
    "jsonc-parser": "^3.3.1",
    "typescript": "^7.0.2",
    "vscode-langservers-extracted": "^4.10.0",
    "vscode-oniguruma": "^2.0.1"
  },
  "devDependencies": {
    "@blocknote/core": "^0.55.0",
    "@blocknote/mantine": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mantine/core": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "d3-force": "^3.0.0",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vscode-textmate": "^9.3.2",
    "wait-on": "^9.5.1"
  }
}
